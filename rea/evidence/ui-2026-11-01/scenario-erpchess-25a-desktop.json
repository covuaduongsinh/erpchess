{
 "browser": {
  "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
  "headless": true,
  "mode": "launch"
 },
 "actions": [
  {
   "step_id": "login_form",
   "locator": {
    "selector": "input[name=email]",
    "kind": "css"
   },
   "state": "visible",
   "timeout_ms": 60000,
   "action": "wait_for"
  },
  {
   "step_id": "fill_user",
   "value": {
    "secret_id": "erp_user",
    "source": "secret"
   },
   "locator": {
    "selector": "input[name=email]",
    "kind": "css"
   },
   "timeout_ms": 10000,
   "action": "fill"
  },
  {
   "step_id": "fill_pass",
   "value": {
    "secret_id": "erp_pass",
    "source": "secret"
   },
   "locator": {
    "selector": "input[name=password]",
    "kind": "css"
   },
   "timeout_ms": 10000,
   "action": "fill"
  },
  {
   "step_id": "submit",
   "locator": {
    "selector": "button[type=submit]",
    "kind": "css"
   },
   "timeout_ms": 15000,
   "action": "click"
  },
  {
   "step_id": "after_login",
   "duration_ms": 8000,
   "action": "wait_for_timeout"
  },
  {
   "step_id": "go_dashboard",
   "timeout_ms": 60000,
   "wait_until": "load",
   "destination": {
    "url": "http://localhost:4173/dashboard"
   },
   "action": "goto"
  },
  {
   "step_id": "shot_dashboard",
   "duration_ms": 6000,
   "action": "wait_for_timeout"
  },
  {
   "step_id": "go_students",
   "timeout_ms": 60000,
   "wait_until": "load",
   "destination": {
    "url": "http://localhost:4173/administration/students"
   },
   "action": "goto"
  },
  {
   "step_id": "shot_students",
   "duration_ms": 6000,
   "action": "wait_for_timeout"
  },
  {
   "step_id": "go_batches",
   "timeout_ms": 60000,
   "wait_until": "load",
   "destination": {
    "url": "http://localhost:4173/batches"
   },
   "action": "goto"
  },
  {
   "step_id": "shot_batches",
   "duration_ms": 6000,
   "action": "wait_for_timeout"
  },
  {
   "step_id": "go_quiz_list",
   "timeout_ms": 60000,
   "wait_until": "load",
   "destination": {
    "url": "http://localhost:4173/quiz/list"
   },
   "action": "goto"
  },
  {
   "step_id": "shot_quiz_list",
   "duration_ms": 6000,
   "action": "wait_for_timeout"
  },
  {
   "step_id": "go_game_area",
   "timeout_ms": 60000,
   "wait_until": "load",
   "destination": {
    "url": "http://localhost:4173/game-area"
   },
   "action": "goto"
  },
  {
   "step_id": "shot_game_area",
   "duration_ms": 6000,
   "action": "wait_for_timeout"
  },
  {
   "step_id": "go_board",
   "timeout_ms": 60000,
   "wait_until": "load",
   "destination": {
    "url": "http://localhost:4173/analysis"
   },
   "action": "goto"
  },
  {
   "step_id": "shot_board",
   "duration_ms": 6000,
   "action": "wait_for_timeout"
  },
  {
   "step_id": "go_preferences",
   "timeout_ms": 60000,
   "wait_until": "load",
   "destination": {
    "url": "http://localhost:4173/preferences"
   },
   "action": "goto"
  },
  {
   "step_id": "shot_preferences",
   "duration_ms": 6000,
   "action": "wait_for_timeout"
  }
 ],
 "start_url": {
  "url": "http://localhost:4173/login"
 },
 "capture": {
  "after_each_step": [
   "screenshot",
   "url"
  ],
  "at_end": [
   "url"
  ]
 },
 "environment": {
  "color_scheme": "light",
  "service_workers": "allow",
  "reduced_motion": "reduce",
  "timezone": "Asia/Ho_Chi_Minh",
  "viewport": {
   "device_scale_factor": 1,
   "width": 1440,
   "height": 900
  },
  "locale": "vi-VN"
 },
 "secrets": [
  {
   "secret_id": "erp_user",
   "environment_variable": "ERP_TEST_EMAIL"
  },
  {
   "secret_id": "erp_pass",
   "environment_variable": "ERP_TEST_PASSWORD"
  }
 ]
}