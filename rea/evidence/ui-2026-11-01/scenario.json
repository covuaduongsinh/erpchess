{
  "browser": {
    "executable_path": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
    "headless": true,
    "mode": "launch"
  },
  "actions": [
    {
      "step_id": "login_form",
      "locator": {
        "selector": "#username",
        "kind": "css"
      },
      "state": "visible",
      "timeout_ms": 30000,
      "action": "wait_for"
    },
    {
      "step_id": "fill_user",
      "value": {
        "secret_id": "cl_user",
        "source": "secret"
      },
      "locator": {
        "selector": "#username",
        "kind": "css"
      },
      "timeout_ms": 10000,
      "action": "fill"
    },
    {
      "step_id": "fill_pass",
      "value": {
        "secret_id": "cl_pass",
        "source": "secret"
      },
      "locator": {
        "selector": "#password",
        "kind": "css"
      },
      "timeout_ms": 10000,
      "action": "fill"
    },
    {
      "step_id": "submit",
      "locator": {
        "selector": "button[type=submit]",
        "kind": "css"
      },
      "timeout_ms": 15000,
      "action": "click"
    },
    {
      "step_id": "after_login",
      "duration_ms": 8000,
      "action": "wait_for_timeout"
    },
    {
      "step_id": "go_p_dashboard",
      "timeout_ms": 45000,
      "wait_until": "load",
      "destination": {
        "url": "https://platform.chesslang.com/dashboard"
      },
      "action": "goto"
    },
    {
      "step_id": "shot_p_dashboard",
      "duration_ms": 6000,
      "action": "wait_for_timeout"
