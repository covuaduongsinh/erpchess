      "url"
    ],
    "at_end": [
      "url"
    ]
  },
  "environment": {
    "color_scheme": "light",
    "service_workers": "allow",
    "reduced_motion": "reduce",
    "timezone": "Asia/Ho_Chi_Minh",
    "viewport": {
      "device_scale_factor": 1,
      "width": 1440,
      "height": 900
    },
    "locale": "en-US"
  },
  "secrets": [
