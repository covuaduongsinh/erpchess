# Supabase tự dựng (self-host) từ 2026-11-02: https://supabaseerpchess.dsc.edu.vn
# (cloud erpchess-dev chỉ còn chạy song song để dự phòng). Khoá = ANON_KEY hoặc publishable key của instance
# (xem biến môi trường của stack Supabase trong Dokploy). KHÔNG commit khoá thật.
VITE_SUPABASE_URL=https://supabaseerpchess.dsc.edu.vn
VITE_SUPABASE_PUBLISHABLE_KEY=<ANON_KEY của instance self-host>
# Trang công khai (apps/site) — dùng cho mã QR trên chứng chỉ
VITE_SITE_URL=http://localhost:3000
